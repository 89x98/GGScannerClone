#!/bin/bash
# Install: git config core.hooksPath .githooks
set -e
cd "$(git rev-parse --show-toplevel)"

# Validate the actual outgoing trees, not uncommitted working-tree keys.
revisions=()
while read -r local_ref local_sha remote_ref remote_sha; do
    if [[ "$local_sha" != "0000000000000000000000000000000000000000" ]]; then
        revisions+=(--revision "$local_sha")
    fi
done
if [[ ${#revisions[@]} -eq 0 ]]; then
    exit 0
fi

echo "Checking Genshin and Star Rail capture keys before push..."
uv run --no-project python scripts/check_capture_keys.py "${revisions[@]}"
uv run --no-project python -m unittest discover -s scripts -p test_check_capture_keys.py

mkdir -p test-results
test_log="test-results/pre-push-capture-$$.log"
trap 'rm -f "$test_log"' EXIT
for package in genshin_scanner hsr_scanner; do
    echo "Running $package capture tests..."
    if ! cargo test -p "$package" --features capture > "$test_log" 2>&1; then
        cat "$test_log"
        echo "PUSH BLOCKED: capture tests failed."
        exit 1
    fi
    tail -n 8 "$test_log"
done
echo "Capture key checks and tests passed."
